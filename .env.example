# FixMyDorm – Environment Variables
# Copy this to .env.local and fill in values.

# AWS General
NEXT_PUBLIC_AWS_REGION=eu-north-1

# Amazon Cognito (public — used by browser)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# AWS IAM Credentials (server-side only — used by API routes)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Amazon DynamoDB
DYNAMODB_TABLE_COMPLAINTS=fixmydorm-complaints

# Amazon S3
NEXT_PUBLIC_S3_BUCKET=fixmydorm-uploads

# Amazon Bedrock (optional — falls back to manual classification)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# API Gateway (future — Phase 3+)
NEXT_PUBLIC_API_GATEWAY_URL=
